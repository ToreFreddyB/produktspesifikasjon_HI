  <element name="BunnprøverLinjer" substitutionGroup="umlmodell:GenerelleEgenskaperStasjoner" type="umlmodell:BunnprøverLinjerType">
    <annotation>
      <documentation>Mareanostasjon hvor det er tatt bunnprøver med tauede redskaper: Bomtrål, RP-slede og Video-rigg.
-- Definition --
Mareano station where bottom samples are collected using beamtrawl., RP-sledge and video.</documentation>
    </annotation>
  </element>
  <complexType name="BunnprøverLinjerType">
    <complexContent>
      <extension base="umlmodell:GenerelleEgenskaperStasjonerType">
        <sequence>
          <element name="linje" type="gml:CurvePropertyType">
            <annotation>
              <documentation>egenskap som inneholder objektets geometri</documentation>
            </annotation>
          </element>
          <element name="redskap" type="string">
            <annotation>
              <documentation>type redskap benyttet for prøvetakingen.
-- Definition --
Name of equipment used for the sampling.</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">REDSKAP</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element name="toktNummer" type="integer">
            <annotation>
              <documentation>toktnummer ved Havforskningsinstituttet.
-- Definition --
Cruise number at IMR.</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">TOKTNUMMER</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element name="referanseStasjon" type="integer">
            <annotation>
              <documentation>referansestasjon, unik innen MAREANO.
-- Definition --
Reference number during MAREANO prosject (superstation).</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">REFERANSESTASJON</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element name="stasjonNummer" type="integer">
            <annotation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">STASJONNUMMER</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element name="prøveNummer" type="integer">
            <annotation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">PRØVENUMMER</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element name="redskapKode" type="integer">
            <annotation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">REDSKAPKODE</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element name="dato" type="date">
            <annotation>
              <documentation>observasjonsdato.
-- Definition --
Date of observation.</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">DATO</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element name="lengdegrad" type="double">
            <annotation>
              <documentation>lengdegrad som prøven ble tatt på.
-- Definition --
Longitude where the sample was taken.</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">LENGDEGRAD</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element name="breddegrad" type="double">
            <annotation>
              <documentation>breddegrad som prøven ble tatt på.
-- Definition --
Latitude where the sample was taken.</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">BREDDEGRAD</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element name="bunndyp" type="integer">
            <annotation>
              <documentation>bunndyp der prøven er tatt.
-- Definition --
Bottomdepth where the sample is taken.</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">BUNNDYP</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
        </sequence>
      </extension>
    </complexContent>
  </complexType>
  <complexType name="BunnprøverLinjerPropertyType">
