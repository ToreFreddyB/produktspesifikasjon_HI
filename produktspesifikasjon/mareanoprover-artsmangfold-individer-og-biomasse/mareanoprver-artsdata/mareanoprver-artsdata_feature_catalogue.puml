@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title Mareanoprøver - Artsmangfold, individer og biomasse - mareanoprøver_artsdata - Objekttyper

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "Objekttyper" {

  class "GrabbPrøver" as GrabbPr_ver <<featureType>> {
    + posisjon [1] : Punkt
    + redskap [1] : CharacterString
    + arterEnhet [1] : CharacterString
    + biomasseEnhet [1] : CharacterString
    + individerEnhet [1] : CharacterString
  }

  abstract class "FellesEgenskaperPrøver" as FellesEgenskaperPr_ver <<featureType>> {
    + referanseStasjon [1] : Integer
    + toktNummer [1] : Integer
    + arter [1] : Integer
    + individer [1] : Real
    + biomasseVekt [1] : Real
    + lengdegrad [1] : Real
    + breddegrad [1] : Real
    + bunndyp [1] : Real
  }

  class "BomtrålPrøver" as Bomtr_lPr_ver <<featureType>> {
    + posisjon [1] : Punkt
    + redskap [1] : CharacterString
    + arterEnhet [1] : CharacterString
    + biomasseEnhet [1] : CharacterString
    + individerEnhet [1] : CharacterString
  }

  class "SledePrøver" as SledePr_ver <<featureType>> {
    + posisjon [1] : Punkt
    + redskap [1] : CharacterString
    + arterEnhet [1] : CharacterString
    + biomasseEnhet [1] : CharacterString
    + individerEnhet [1] : CharacterString
  }

  abstract class "GenerelleEgenskaperPrøver" as GenerelleEgenskaperPr_ver <<featureType>> {
    + identifikasjon [1] : Identifikasjon
    + kvalitet [0..1] : Posisjonskvalitet
    + datauttaksdato [0..1] : Date
    + førsteDatafangstdato [1] : Date
    + opphav [1] : CharacterString
  }

  class Identifikasjon <<dataType>> {
    + lokalId [1] : CharacterString
    + navnerom [1] : CharacterString
    + versjonId [1] : CharacterString
  }

  class Posisjonskvalitet <<dataType>> {
    + målemetode [1] : Målemetode
  }
}

  FellesEgenskaperPr_ver <|-- GrabbPr_ver
  GenerelleEgenskaperPr_ver <|-- FellesEgenskaperPr_ver
  FellesEgenskaperPr_ver <|-- Bomtr_lPr_ver
  FellesEgenskaperPr_ver <|-- SledePr_ver

@enduml
