									<UML:ModelElement.taggedValue>
										<UML:TaggedValue tag="description" value="navnerom som unikt identifiserer datakilden til objektet, starter med to bokstavs kode jfr ISO 3166. Benytter understreking  (&quot;_&quot;) dersom data produsenten ikke er assosiert med bare et land.&#xA;&#xA;NOTE 1 : Verdien for nanverom vil eies av den dataprodusent som har ansvar for de unike identifikatorene og vil registreres i &quot;INSPIRE external  Object Identifier Namespaces Register&quot;&#xA;&#xA;Eksempel: NO for Norge."/>
										<UML:TaggedValue tag="type" value="CharacterString"/>
										<UML:TaggedValue tag="derived" value="0"/>
										<UML:TaggedValue tag="containment" value="Not Specified"/>
