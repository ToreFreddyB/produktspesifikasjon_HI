		<UML:Diagram name="Hoveddiagram-Hornkoraller" xmi.id="EAID_0B37AB29_2DA2_4136_9DD8_535E08E851DF" diagramType="ClassDiagram" owner="EAPK_9D1544EB_4D52_4069_8D8E_5DA000498300" toolName="Enterprise Architect 2.5">
			<UML:ModelElement.taggedValue>
